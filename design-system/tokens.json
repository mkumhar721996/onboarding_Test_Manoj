{
  "color-fg": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.1216, 0.1608, 0.2157], "hex": "#1f2937" },
    "$description": "Default body text color. Paired with color-bg at 14.7:1 contrast."
  },
  "color-bg": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#ffffff" },
    "$description": "Default page and surface background."
  },
  "color-primary": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.1451, 0.3882, 0.9216], "hex": "#2563eb" },
    "$description": "Brand accent used for primary actions and focus states."
  },
  "color-border": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.8196, 0.8353, 0.8588], "hex": "#d1d5db" },
    "$description": "Default hairline border for cards, inputs, and dividers."
  },
  "color-surface-subtle": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.9333, 0.9490, 1.0], "hex": "#eef2ff" },
    "$description": "Low-emphasis tinted background, e.g. chips and secondary buttons on hover."
  },

  "space-1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" }, "$description": "Tightest spacing: icon-to-label gaps, chip padding." },
  "space-2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" }, "$description": "Compact spacing: control internal padding, stack gaps in dense lists." },
  "space-3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" }, "$description": "Default spacing: button padding, form field gaps." },
  "space-4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" }, "$description": "Roomy spacing: card padding, section gaps." },

  "radius-sm": { "$type": "dimension", "$value": { "value": 4, "unit": "px" }, "$description": "Chips, inputs, small controls." },
  "radius-md": { "$type": "dimension", "$value": { "value": 8, "unit": "px" }, "$description": "Buttons and most interactive controls." },
  "radius-lg": { "$type": "dimension", "$value": { "value": 16, "unit": "px" }, "$description": "Cards and containers." },

  "font-size-sm": { "$type": "dimension", "$value": { "value": 12, "unit": "px" }, "$description": "Captions, chip labels, table metadata." },
  "font-size-md": { "$type": "dimension", "$value": { "value": 14, "unit": "px" }, "$description": "Default body and control text." },
  "font-size-lg": { "$type": "dimension", "$value": { "value": 18, "unit": "px" }, "$description": "Section headings and card titles." },

  "font-family-base": { "$type": "fontFamily", "$value": "Inter, system-ui, -apple-system, sans-serif", "$description": "Default typeface across the product." },
  "font-weight-regular": { "$type": "fontWeight", "$value": 400, "$description": "Body text weight." },
  "font-weight-semibold": { "$type": "fontWeight", "$value": 600, "$description": "Headings, button labels, emphasis." },

  "shadow-card": {
    "$type": "shadow",
    "$value": {
      "color": { "colorSpace": "srgb", "components": [0.1216, 0.1608, 0.2157], "hex": "#1f2937", "alpha": 0.08 },
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 1, "unit": "px" },
      "blur": { "value": 3, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    },
    "$description": "Resting elevation for cards."
  },

  "button-primary-background": { "$type": "color", "$value": "{color-primary}", "$description": "Primary button fill." },
  "button-primary-foreground": { "$type": "color", "$value": "{color-bg}", "$description": "Primary button label color." },
  "button-primary-border": { "$type": "color", "$value": "{color-primary}", "$description": "Primary button border." },
  "button-primary-radius": { "$type": "dimension", "$value": "{radius-md}", "$description": "Primary button corner radius." },
  "button-primary-padding": { "$type": "dimension", "$value": "{space-3}", "$description": "Primary button internal padding." },

  "button-secondary-background": { "$type": "color", "$value": "{color-bg}", "$description": "Secondary button fill." },
  "button-secondary-foreground": { "$type": "color", "$value": "{color-primary}", "$description": "Secondary button label color." },
  "button-secondary-border": { "$type": "color", "$value": "{color-border}", "$description": "Secondary button border." },
  "button-secondary-radius": { "$type": "dimension", "$value": "{radius-md}", "$description": "Secondary button corner radius." },
  "button-secondary-padding": { "$type": "dimension", "$value": "{space-3}", "$description": "Secondary button internal padding." },

  "card-default-background": { "$type": "color", "$value": "{color-bg}", "$description": "Card surface fill." },
  "card-default-border": { "$type": "color", "$value": "{color-border}", "$description": "Card hairline border." },
  "card-default-radius": { "$type": "dimension", "$value": "{radius-lg}", "$description": "Card corner radius." },
  "card-default-padding": { "$type": "dimension", "$value": "{space-4}", "$description": "Card internal padding." },

  "chip-default-background": { "$type": "color", "$value": "{color-surface-subtle}", "$description": "Chip fill." },
  "chip-default-foreground": { "$type": "color", "$value": "{color-primary}", "$description": "Chip label color." },
  "chip-default-border": { "$type": "color", "$value": "{color-border}", "$description": "Chip border." },
  "chip-default-radius": { "$type": "dimension", "$value": "{radius-sm}", "$description": "Chip corner radius." },
  "chip-default-padding": { "$type": "dimension", "$value": "{space-1}", "$description": "Chip internal padding." },

  "input-default-background": { "$type": "color", "$value": "{color-bg}", "$description": "Form control fill." },
  "input-default-foreground": { "$type": "color", "$value": "{color-fg}", "$description": "Form control text color." },
  "input-default-border": { "$type": "color", "$value": "{color-border}", "$description": "Form control border." },
  "input-default-radius": { "$type": "dimension", "$value": "{radius-sm}", "$description": "Form control corner radius." },
  "input-default-padding": { "$type": "dimension", "$value": "{space-2}", "$description": "Form control internal padding." }
}
